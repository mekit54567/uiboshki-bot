# Охранник слоёв (docs/adr/0002-layers.md): импорты идут только сверху вниз.
#     bot | jobs  →  ops  →  features  →  core;   database — только core
# CI: «lint-imports». Новый прямой импорт против правил — CI красный.
# Исключений нет: 02.11 их было 25, 03.11 — ноль (ignore_imports не нужен).
# Нужно позвать слой выше — значит, общее лежит не там: опусти его ниже.

[importlinter]
root_packages =
    kapibara
    database
    handlers
    webapp
include_external_packages = False

[importlinter:contract:core]
name = core ничего своего не импортирует
type = forbidden
source_modules = kapibara.core
forbidden_modules =
    kapibara.features
    kapibara.ops
    kapibara.bot
    kapibara.jobs
    database
    handlers
    webapp
allow_indirect_imports = True
[importlinter:contract:features]
name = features не знают про Telegram, HTTP, задания и эксплуатацию
type = forbidden
source_modules = kapibara.features
forbidden_modules =
    kapibara.ops
    kapibara.bot
    kapibara.jobs
    handlers
    webapp
allow_indirect_imports = True
[importlinter:contract:ops]
name = ops не зовёт Telegram-слой и планировщик
type = forbidden
source_modules = kapibara.ops
forbidden_modules =
    kapibara.bot
    kapibara.jobs
allow_indirect_imports = True
[importlinter:contract:bot]
name = Telegram-слой не зовёт планировщик
type = forbidden
source_modules = kapibara.bot
forbidden_modules =
    kapibara.jobs
allow_indirect_imports = True
[importlinter:contract:jobs]
name = планировщик не зовёт Telegram-слой
type = forbidden
source_modules = kapibara.jobs
forbidden_modules =
    kapibara.bot
allow_indirect_imports = True
[importlinter:contract:database]
name = база не знает про логику продукта
type = forbidden
source_modules = database
forbidden_modules =
    kapibara.features
    kapibara.ops
    kapibara.bot
    kapibara.jobs
    handlers
    webapp
allow_indirect_imports = True
