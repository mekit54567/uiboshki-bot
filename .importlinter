# Охранник слоёв (docs/adr/0002-layers.md): импорты идут только сверху вниз.
#     bot | jobs  →  ops  →  features  →  core;   database — только core
# CI: «lint-imports». Новый прямой импорт против правил — CI красный.
# ignore_imports — нарушения, которые были на 02.11 (25 штук; 03.11 — 12). Это список
# долга: его можно только сокращать (как храповик, docs/adr/0006-ratchet.md).
# Починил — удали строку отсюда (одинаковый список во всех правилах).

[importlinter]
root_packages =
    kapibara
    database
    handlers
    webapp
include_external_packages = False

[importlinter:contract:core]
name = core ничего своего не импортирует
type = forbidden
source_modules = kapibara.core
forbidden_modules =
    kapibara.features
    kapibara.ops
    kapibara.bot
    kapibara.jobs
    database
    handlers
    webapp
allow_indirect_imports = True
ignore_imports =
    database.files -> kapibara.features.lectures.categories
    kapibara.features.deadlines.reminders -> kapibara.bot.keyboards
    kapibara.features.deadlines.soon -> kapibara.bot.keyboards
    kapibara.features.notifications.evening_digest -> handlers.weather
    kapibara.features.notifications.evening_digest -> kapibara.bot.keyboards
    kapibara.features.notifications.grade_alerts -> kapibara.bot.keyboards
    kapibara.features.notifications.new_tasks -> kapibara.bot.keyboards
    kapibara.features.notifications.quiz_alerts -> kapibara.bot.keyboards
    kapibara.features.notifications.weekly_digest -> kapibara.bot.keyboards
    kapibara.features.privacy.privacy -> kapibara.ops.s3_store
    kapibara.features.sdo.accounts -> kapibara.bot.keyboards
    kapibara.jobs.scheduler -> kapibara.bot.keyboards

[importlinter:contract:features]
name = features не знают про Telegram, HTTP, задания и эксплуатацию
type = forbidden
source_modules = kapibara.features
forbidden_modules =
    kapibara.ops
    kapibara.bot
    kapibara.jobs
    handlers
