# Переменные бота — те же, что были в Amvera → «Переменные» и «Секреты».
# Одна строка — одна переменная: ИМЯ=значение (без кавычек и пробелов вокруг =).
# Строка с # в начале не считается: чтобы включить — убери # и впиши значение
# (пустое «ИМЯ=» не оставляй — это «задано пустым», а не «не задано»).
# Файл видит только root. После правки — kap restart.

BOT_TOKEN=
STAROSTA_ID=
WEBAPP_URL=https://www.uiboshki.ru
EMBED_PROVIDER=rubert-mini-frida

#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
#DEEPSEEK_API_KEY=
#SDO_SESSION_COOKIE=
#SDO_CRYPT_KEY=

# VPN для Telegram и ИИ: с обычного сервера в России Gemini не пускает, а
# встроенного прокси, как у Amvera, тут нет. Ссылка vless://… одной строкой.
#XRAY_CONFIG=
#PROXY_COUNTRY=

# Юрлицо хостинга для политики — из договора Timeweb Cloud: «ООО … (ИНН …, город)».
#HOSTING_ORG=

#PD_FIO=
#PD_INN=
#PD_EMAIL=
#PD_CITY=

#BACKUP_S3_BUCKET=
#BACKUP_S3_KEY_ID=
#BACKUP_S3_SECRET=
#BACKUP_S3_ENDPOINT=

# Остальное, что было в Amvera (BOT_USERNAME, CHANNEL_URL, CHANNEL_ID, LOGIN_CHANNEL,
# VK_CLIENT_ID, YANDEX_CLIENT_ID, REVIEW_CODE, YOOKASSA_*, PULSE_COOKIE, AI_* …) — ниже.
